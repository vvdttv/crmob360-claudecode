# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api
APP_URL=http://localhost:4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=crmob360
DB_PASSWORD=crmob360_password
DB_DATABASE=crmob360_db
DB_SYNC=false
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI API (Módulo 4 - IA)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7

# WhatsApp Business API (Módulo 1.2 - Omnichannel)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-token

# Twilio (WhatsApp Pessoal/Business)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Google APIs
GOOGLE_MAPS_API_KEY=your-google-maps-key
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Portais Imobiliários (Módulo 5.2)
ZAP_API_KEY=
ZAP_API_SECRET=
IMOVELWEB_API_KEY=
IMOVELWEB_API_SECRET=

# Fipe-ZAP (Módulo 11.5 - Dados de Mercado)
FIPEZAP_API_KEY=
FIPEZAP_API_URL=https://api.fipezap.com.br

# Gateway de Pagamento (Módulo 9.3)
PAYMENT_GATEWAY_PROVIDER=iugu
IUGU_API_KEY=
IUGU_ACCOUNT_ID=
ASAAS_API_KEY=
ASAAS_WALLET_ID=

# Email (Módulo 2.2)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@crmob360.com.br
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@crmob360.com.br

# Assinatura Digital (Módulo 8.2)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
CLICKSIGN_API_KEY=

# ERP Integrations (Módulo 9.7)
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
OMIE_APP_KEY=
OMIE_APP_SECRET=

# Storage (S3 para documentos e imagens)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=crmob360-files

# CloudFront (CDN)
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_DOMAIN=

# Sentry (Error Tracking)
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# LGPD (Módulo 13)
LGPD_DATA_RETENTION_YEARS=5
LGPD_ANONYMIZATION_SCHEDULE=0 2 * * 0
LGPD_DPO_EMAIL=dpo@crmob360.com.br

# Logs
LOG_LEVEL=debug
LOG_FILE_PATH=logs/

# Bull Queue
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin123
